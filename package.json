{
  "name": "riftlens",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "db:push": "bun run --cwd packages/db push",
    "db:generate": "bun run --cwd packages/db generate",
    "db:studio": "bun run --cwd packages/db studio",
    "worker:ladder": "bun run --cwd apps/worker ladder",
    "seed:demo": "bun run --cwd apps/worker seed:demo",
    "worker:crawl": "bun run --cwd apps/worker crawl",
    "worker:aggregate": "bun run --cwd apps/worker aggregate"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "5.9.3"
  }
}
