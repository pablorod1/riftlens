# Clave de https://developer.riotgames.com (la de desarrollo caduca cada 24 h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Límites de la clave "ventana_en_s" -> "peticiones:segundos,..." (dev key por defecto)
RIOT_RATE_LIMITS=20:1,100:120

# Base de datos. En local un fichero SQLite (ruta relativa a apps/* y packages/*).
# En producción: libsql://<db>-<org>.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:../../data/riftlens.db
DATABASE_AUTH_TOKEN=
